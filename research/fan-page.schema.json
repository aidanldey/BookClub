{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bookclub.example/schemas/fan-page.schema.json",
  "title": "Book Fan Page Research Output",
  "description": "Structured research output for one book fan page. Every field is optional except `book` and `research_notes` — an honestly empty field beats an invented one.",
  "type": "object",
  "required": ["book", "research_notes"],
  "additionalProperties": false,
  "properties": {
    "book": {
      "type": "object",
      "required": ["title", "author", "year_published", "one_line_pitch"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string" },
        "author": { "type": "string" },
        "year_published": { "type": "integer" },
        "original_language": { "type": "string" },
        "page_count": { "type": "integer" },
        "reading_time_note": { "type": "string", "description": "How readers describe the pace, e.g. 'a fast 400 pages' or 'slow first 150, then unputdownable'." },
        "shelf": { "type": "string", "description": "Genre as filed." },
        "shelf_actual": { "type": "string", "description": "Genre as readers actually experience it, if different." },
        "series": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "name": { "type": "string" },
            "position": { "type": "integer" },
            "complete": { "type": "boolean" },
            "reading_order_note": { "type": "string" }
          }
        },
        "one_line_pitch": { "type": "string", "description": "Spoiler-free, in the voice of someone who loves it." },
        "translations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["translator"],
            "additionalProperties": false,
            "properties": {
              "translator": { "type": "string" },
              "year": { "type": "integer" },
              "reader_verdict": { "type": "string" },
              "consensus": { "$ref": "#/$defs/consensus" }
            }
          }
        },
        "notable_editions": { "type": "array", "items": { "type": "string" } }
      }
    },

    "resonance": {
      "type": "object",
      "description": "Why the book sticks with people. The emotional heart of the page.",
      "additionalProperties": false,
      "properties": {
        "core_reason": { "$ref": "#/$defs/finding", "description": "The single most repeated reason readers love it." },
        "dominant_emotion": { "$ref": "#/$defs/finding" },
        "what_it_does_to_readers": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
        "best_life_stage": { "$ref": "#/$defs/finding", "description": "When in life this book lands hardest." },
        "reread_value": { "$ref": "#/$defs/finding" },
        "the_moment": { "$ref": "#/$defs/finding", "description": "The scene readers name as the point the book got them." },
        "comparisons": { "type": "array", "items": { "type": "string" } }
      }
    },

    "craft": {
      "type": "object",
      "description": "What readers admire about how the book is built.",
      "additionalProperties": false,
      "properties": {
        "standout_element": {
          "type": "string",
          "enum": ["prose", "structure", "characters", "worldbuilding", "plot", "humor", "ideas", "ending", "voice", "atmosphere"]
        },
        "standout_detail": { "$ref": "#/$defs/finding", "description": "The specific thing about that element, not the adjective." },
        "unique_claim": { "$ref": "#/$defs/finding", "description": "What readers say no other book does." },
        "formal_choices": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
        "difficulty_curve": { "$ref": "#/$defs/finding" }
      }
    },

    "characters": {
      "type": "array",
      "description": "Ordered by how often readers name them, most-loved first.",
      "items": {
        "type": "object",
        "required": ["name", "why_readers_love_them"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "role": { "type": "string", "description": "Spoiler-free role, e.g. 'the narrator's brother'." },
          "why_readers_love_them": { "$ref": "#/$defs/finding" },
          "signature_moment": { "$ref": "#/$defs/finding" },
          "divisive": { "type": "boolean" },
          "the_case_against": { "type": "string", "description": "Required when divisive is true. Steelman it." },
          "heartbreak": { "type": "boolean", "description": "True if readers name this character as the one who broke them." },
          "fan_favorite_rank": { "type": "integer" }
        }
      }
    },

    "book_quotes": {
      "type": "array",
      "description": "Lines from the book that readers quote most. Ordered by frequency.",
      "items": {
        "type": "object",
        "required": ["text", "spoiler"],
        "additionalProperties": false,
        "properties": {
          "text": { "type": "string", "description": "Verbatim. Keep short for in-copyright works." },
          "speaker": { "type": "string" },
          "location": { "type": "string", "description": "Roughly where it falls, e.g. 'Part II, ch. 34' or 'closing line'." },
          "translation": { "type": "string", "description": "Translator, for translated works — famous lines differ by translation." },
          "why_it_lands": { "$ref": "#/$defs/finding" },
          "spoiler": { "type": "boolean" },
          "frequency": { "$ref": "#/$defs/consensus" },
          "tattoo_tier": { "type": "boolean", "description": "Readers report tattooing it, using it in vows, etc." },
          "commonly_misread": { "type": "string", "description": "The actual context, when the line is usually quoted out of it." }
        }
      }
    },

    "reader_voices": {
      "type": "array",
      "description": "Real, linkable reader comments. NEVER fabricate an entry here.",
      "items": {
        "type": "object",
        "required": ["quote", "username", "platform", "permalink"],
        "additionalProperties": false,
        "properties": {
          "quote": { "type": "string", "description": "1-3 sentences, verbatim. Trim with '…' only." },
          "username": { "type": "string", "description": "Public handle only. Never a real name or other identifying detail." },
          "platform": { "type": "string", "description": "e.g. 'reddit r/books', 'Goodreads', 'StoryGraph'." },
          "permalink": { "type": "string", "format": "uri" },
          "date": { "type": "string", "description": "ISO date or year." },
          "angle": {
            "type": "string",
            "description": "What this voice is doing on the page.",
            "enum": ["love", "craft", "character", "emotional-impact", "reading-experience", "reread", "converted-skeptic", "critical", "format-recommendation", "funny"]
          },
          "spoiler": { "type": "boolean" }
        }
      }
    },

    "debates": {
      "type": "array",
      "description": "What the fandom argues about. Seeds club discussion.",
      "items": {
        "type": "object",
        "required": ["question", "side_a", "side_b"],
        "additionalProperties": false,
        "properties": {
          "question": { "type": "string" },
          "side_a": { "type": "string", "description": "Steelmanned." },
          "side_b": { "type": "string", "description": "Steelmanned." },
          "settled": { "type": "boolean", "description": "False when the fandom genuinely has no answer." },
          "spoiler": { "type": "boolean" },
          "discussion_prompt": { "type": "string", "description": "How to pose this to the club." }
        }
      }
    },

    "before_you_start": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "who_its_for": { "type": "string" },
        "who_bounces_off": { "type": "string" },
        "content_warnings": { "type": "array", "items": { "type": "string" }, "description": "Plain, non-judgmental." },
        "audiobook": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "recommended_narrator": { "type": "string" },
            "verdict": { "type": "string" },
            "preferred_format": { "type": "string", "enum": ["print", "audio", "either"] }
          }
        },
        "wish_id_known": { "type": "array", "items": { "type": "string" } },
        "companion_material": { "type": "array", "items": { "type": "string" } },
        "commitment_point": { "type": "string", "description": "Where readers say you'll know, e.g. 'if page 200 hasn't got you, stop'." },
        "adaptations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["title"],
            "additionalProperties": false,
            "properties": {
              "title": { "type": "string" },
              "year": { "type": "integer" },
              "medium": { "type": "string" },
              "reader_verdict": { "type": "string" },
              "before_or_after": { "type": "string", "enum": ["before", "after", "either", "avoid"] }
            }
          }
        }
      }
    },

    "if_you_loved_this": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "author", "reason"],
        "additionalProperties": false,
        "properties": {
          "title": { "type": "string" },
          "author": { "type": "string" },
          "reason": { "type": "string", "description": "One line on why this pairing works." },
          "same_author": { "type": "boolean" },
          "consensus": { "$ref": "#/$defs/consensus" }
        }
      }
    },

    "research_notes": {
      "type": "object",
      "required": ["sources", "gaps"],
      "additionalProperties": false,
      "properties": {
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["url"],
            "additionalProperties": false,
            "properties": {
              "url": { "type": "string", "format": "uri" },
              "title": { "type": "string" },
              "platform": { "type": "string" },
              "date": { "type": "string" },
              "comments_read": { "type": "integer" }
            }
          }
        },
        "gaps": { "type": "array", "items": { "type": "string" }, "description": "Core questions that found no real answer." },
        "verify_before_publishing": { "type": "array", "items": { "type": "string" } },
        "researched_at": { "type": "string", "format": "date" }
      }
    }
  },

  "$defs": {
    "consensus": {
      "type": "string",
      "description": "How widely held this view is among readers.",
      "enum": ["near-universal", "common", "minority", "singular"]
    },
    "finding": {
      "type": "object",
      "required": ["claim"],
      "additionalProperties": false,
      "properties": {
        "claim": { "type": "string", "description": "What readers say. Specific, not adjectival." },
        "consensus": { "$ref": "#/$defs/consensus" },
        "evidence": { "type": "array", "items": { "type": "string", "format": "uri" }, "description": "Permalinks supporting the claim." },
        "spoiler": { "type": "boolean" }
      }
    }
  }
}
